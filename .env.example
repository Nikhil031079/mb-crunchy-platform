# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Razorpay Key ID (from https://dashboard.razorpay.com)
VITE_RAZORPAY_KEY_ID=

# Secret used to sign & verify admin session JWTs.
# Set a long, random value in every environment via:
#   npx convex env set SESSION_SECRET <random-string>
# If unset, a development-only fallback secret is used.
SESSION_SECRET=

# Telegram bot notifications (optional — used by convex/notificationService.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minutes an order may sit unpaid before the cron auto-cancels it and releases
# its reserved stock (default 60). Set 0 to disable auto-cancellation.
RESERVATION_TIMEOUT_MINUTES=
