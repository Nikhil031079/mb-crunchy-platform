# ---------- Frontend (Vite, public by design) ----------
VITE_CONVEX_URL=
VITE_RAZORPAY_KEY_ID=

# ---------- Convex CLI ----------
CONVEX_DEPLOYMENT=

# ---------- Convex backend env (set with: npx convex env set NAME value) ----------
# Required. Signs admin session JWTs. The backend throws at startup if unset.
# Use a long random value, different in every environment.
SESSION_SECRET=

# Razorpay (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Unpaid-order auto-cancel window in minutes (default 60, 0 disables)
RESERVATION_TIMEOUT_MINUTES=

# Owner alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phone OTP provider (POSTs {phone, otp, appName} to this endpoint)
OTP_APP_NAME=MB Crunchy
PHONE_OTP_API_ENDPOINT=
PHONE_OTP_API_KEY=

# Address geocoding (optional)
GOOGLE_GEOCODING_API_KEY=

# Shiprocket
COURIER_SHIPROCKET_BASE_URL=
COURIER_SHIPROCKET_API_EMAIL=
COURIER_SHIPROCKET_API_PASSWORD=
COURIER_SHIPROCKET_WEBHOOK_SECRET=
# true = log courier calls instead of booking real shipments
COURIER_DRY_RUN=true
